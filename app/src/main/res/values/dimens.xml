<resources>
    <dimen name="fab_margin">16dp</dimen>
    <!-- Effective max ball diameter on narrow screens (very large = no cap) -->
    <dimen name="magic_ball_max_diameter">6000dp</dimen>
    <dimen name="screen_top_padding">12dp</dimen>
    <dimen name="title_top_margin">16dp</dimen>
    <!-- Title width weights (float via dimen/format=float trick). image + 2*side = 1.0 -->
    <item name="title_image_weight" format="float" type="dimen">0.95</item>
    <item name="title_side_weight" format="float" type="dimen">0.025</item>
    <dimen name="content_above_ad_padding">20dp</dimen>
    <dimen name="main_bottom_block_padding">16dp</dimen>
    <!-- Fixed pill width: text ellipsizes; avoids width jumping when hint string changes -->
    <dimen name="magic_hint_pill_width">168dp</dimen>
    <dimen name="magic_hint_pill_padding_h">16dp</dimen>
    <dimen name="magic_hint_text_size">14sp</dimen>
    <dimen name="magic_secondary_text_size">14sp</dimen>
    <!-- Inset for bottom chrome (pill + secondary); mobile only nonzero in default bucket -->
    <dimen name="magic_bottom_chrome_horizontal_inset">28dp</dimen>
    <!-- 48dp * 1.2 -->
    <dimen name="magic_circle_button_size">58dp</dimen>
    <dimen name="magic_circle_button_padding">12dp</dimen>
    <!-- Fixed row for secondary line (BORING etc.) — same Main/Msg -->
    <dimen name="magic_secondary_text_block_height">38dp</dimen>
    <!-- Pill row: matches circle buttons so Main pill == Msg bar height -->
    <dimen name="magic_pill_row_height">58dp</dimen>
    <dimen name="magic_pill_to_secondary_gap">8dp</dimen>
    <!-- Reserve before AdMob loads (BANNER ~50dp); slot shows starfield through transparent frame -->
    <dimen name="ad_banner_slot_height">50dp</dimen>
    <!-- pill + gap + secondary + bottom padding -->
    <dimen name="magic_bottom_chrome_height">120dp</dimen>
</resources>
