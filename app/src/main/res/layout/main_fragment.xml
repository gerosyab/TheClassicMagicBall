<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false">

    <net.gerosyab.magicball.ui.view.FrontView
        android:id="@+id/frontview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:clickable="false"
        android:focusable="false"
        android:paddingTop="@dimen/title_top_margin">

        <include layout="@layout/include_magic_title" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/magic_bottom_chrome_height"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="false"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/magic_bottom_chrome_horizontal_inset"
        android:paddingEnd="@dimen/magic_bottom_chrome_horizontal_inset"
        android:paddingBottom="@dimen/main_bottom_block_padding">

        <TextView
            android:id="@+id/hint_action_button"
            android:layout_width="@dimen/magic_hint_pill_width"
            android:layout_height="@dimen/magic_pill_row_height"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_magic_pill_yellow_red"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="@dimen/magic_hint_pill_padding_h"
            android:paddingEnd="@dimen/magic_hint_pill_padding_h"
            android:textColor="@color/magic_red_dark"
            android:textSize="@dimen/magic_hint_text_size"
            android:textStyle="bold" />

        <TextSwitcher
            android:id="@+id/secondary_text_switcher"
            android:layout_width="match_parent"
            android:layout_height="@dimen/magic_secondary_text_block_height"
            android:layout_marginTop="@dimen/magic_pill_to_secondary_gap"
            android:background="@android:color/transparent"
            android:gravity="center_horizontal" />
    </LinearLayout>
</FrameLayout>
